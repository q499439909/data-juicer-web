# Web
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8090
AGENT_WEB_COOKIE_SECURE=false
AGENT_WEB_DATA_DIR=./agent_web/data
AGENT_WEB_TASK_TIMEOUT=3600

# Persistent fair scheduler
AGENT_WEB_MAX_RUNNING_TASKS=3
AGENT_WEB_MAX_RUNNING_PER_USER=1
# 0 means auto-detect host CPUs and reserve two for Web/system.
AGENT_WEB_SCHEDULER_CPU_CAPACITY=0
# -1 means detect GPUs with nvidia-smi.
AGENT_WEB_SCHEDULER_GPU_CAPACITY=-1
AGENT_WEB_SCHEDULER_POLL_SECONDS=1
AGENT_WEB_DISPATCH_LEASE_SECONDS=30

# Execution recommendation thresholds
AGENT_WEB_RAY_BYTES_THRESHOLD=2147483648
AGENT_WEB_RAY_FILE_THRESHOLD=1000

# Existing Agent / Ray settings
RAY_ADDRESS=http://127.0.0.1:8265
AGENT_WEB_RAY_AUTO_START=true
DASHSCOPE_API_KEY=
DJA_SESSION_MODEL=qwen3-max-2026-01-23

# Optional OpenAI-compatible endpoint and planner model overrides.
# DJA_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DJA_PLANNER_MODEL=qwen3-max-2026-01-23
# MODELSCOPE_API_TOKEN=

# .env is loaded as dotenv data, not executed as a shell script.
# Environment variables supplied by the service manager take precedence.
